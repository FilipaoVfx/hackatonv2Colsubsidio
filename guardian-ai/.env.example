# Copia a .env y rellena. NUNCA commitear .env (gitignoreado).

# OpenAI — GPT-4o (LLM Gateway, ADR-012). MANDATORY para conversación real.
OPENAI_API_KEY=sk-proj-...

# ElevenLabs — TTS (voz saliente). Requiere plan pago para voces de librería.
# Sin esto, el dashboard usa Web Speech del navegador como sustituto gratis.
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=...

# Vapi — telefonía. Usa la PRIVATE key (no la public) para API server.
VAPI_API_KEY=...
VAPI_PHONE_ID=...

# Kapso — canal WhatsApp (texto), proxy del Meta Cloud API. OPCIONAL: sin esto
# el chat corre en modo demo offline (/api/whatsapp/simulate-inbound) y la
# respuesta se ve por WebSocket. Para envío/recepción real: cuenta free en
# kapso.ai → API key (Integrations → API keys) → WhatsApp → Sandbox → Add Test
# Number (tu celular) → enviar el código de 6 caracteres → apuntar el webhook
# HTTPS (cloudflared) a /api/whatsapp/webhook.
KAPSO_API_KEY=...
KAPSO_PHONE_NUMBER_ID=...                 # phone_number_id del número (Sandbox o producción)
# KAPSO_WEBHOOK_SECRET=...                # secret_key del webhook (verificación HMAC)
# PUBLIC_BASE_URL=https://xxxx.trycloudflare.com   # base pública HTTPS para el webhook

# Colsubsidio Protege API — cerebro del canal WhatsApp (conversación guiada +
# recomendación por reglas). Cuando está seteado, WhatsApp gira en torno a esta API;
# sin él, WhatsApp cae al motor GPT-4o local. El token es opcional (el spec no declara auth).
# En el compose local apunta al mock: http://mock-protege:9000
COLSUBSIDIO_API_URL=http://147.93.11.136:9000
# COLSUBSIDIO_API_TOKEN=...

# Guardian Conversation Engine (07_FEATURE_GUARDIAN_CONVERSATION_ENGINE.md).
# Se activa solo cuando hay COLSUBSIDIO_API_URL + OPENAI_API_KEY.
# GUARDIAN_DISABLED=1                      # fuerza el fallback (protege rígido / GPT libre)
# KNOWLEDGE_DIR=./knowledge                # corpus RAG (default: knowledge/ junto al binario)

# Supabase — persistencia via pgx (ADR-004). Usa el POOLER (IPv4), no el host directo.
# Formato: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
