# Copia a .env y rellena. NUNCA commitear .env (gitignoreado).

# OpenAI — GPT-4o (LLM Gateway, ADR-012). MANDATORY para conversación real.
OPENAI_API_KEY=sk-proj-...

# ElevenLabs — TTS (voz saliente). Requiere plan pago para voces de librería.
# Sin esto, el dashboard usa Web Speech del navegador como sustituto gratis.
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=...

# Vapi — telefonía. Usa la PRIVATE key (no la public) para API server.
VAPI_API_KEY=...
VAPI_PHONE_ID=...

# Supabase — persistencia via pgx (ADR-004). Usa el POOLER (IPv4), no el host directo.
# Formato: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
